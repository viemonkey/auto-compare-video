# ── TTS Provider ─────────────────────────────────────────────
# "vbee" = Vbee TTS (cần tài khoản) | "edge" = Edge TTS (miễn phí, pure Node.js via edge-tts-universal)
TTS_PROVIDER=edge

# ── Edge TTS (chỉ cần khi TTS_PROVIDER=edge) ────────────────
# vi-VN-NamMinhNeural (nam) | vi-VN-HoaiMyNeural (nữ)
EDGE_VOICE=vi-VN-NamMinhNeural

# ── Vbee TTS (chỉ cần khi TTS_PROVIDER=vbee) ────────────────
VBEE_APP_ID=
VBEE_ACCESS_TOKEN=
# Giọng đọc Vbee — danh sách khác xem vbee.md hoặc trên trang chủ vbee § 5
VBEE_VOICE_CODE=



# ── Gemini API (Auto Compare Video — sinh title/label/points từ 2 ảnh so sánh) ──
# Lấy tại https://aistudio.google.com/apikey — cần quyền gọi model vision (multimodal).
GEMINI_API_KEY=
# Model mặc định: gemini-3.5-flash (đa phương thức, hỗ trợ responseSchema ép JSON — bản duy
# nhất trong 3 model test (3.5/3.6/3.7-flash) trả JSON đúng schema ổn định trên free tier khi
# test 2026-08-29/30; 3.6/3.7-flash lúc thì timeout/503, lúc thì lặp token khi field không có
# maxLength — xem ghi chú trong scripts/generate-compare-content.mjs). Đổi model khác nếu cần —
# kiểm tra model hiện hành tại https://ai.google.dev/gemini-api/docs/models (API đổi model được
# hỗ trợ khá thường xuyên) và test lại bằng DEBUG_GEMINI=1 trước khi đổi mặc định ở đây.
GEMINI_MODEL=gemini-3.5-flash
# (Khuyến nghị) Model dự phòng cho MỌI lời gọi Gemini (sinh nội dung, viết lại/dịch lại 1 dòng, tạo phiên bản thị trường).
# Dùng khi model chính hết lượt retry vì lỗi tạm thời (503/5xx/429 theo phút/timeout) hoặc hết quota THEO NGÀY (429 PerDay):
# server log "[gemini] model chính <A> quá tải → chuyển sang <B>" rồi retry bình thường với <B> (đúng 1 lần chuyển, không lặp).
# Bước 2 hiện badge "Sinh bởi <model> (dự phòng)". Trống / trùng GEMINI_MODEL = không có dự phòng, báo lỗi ngay.
# Tên model được kiểm tra (list models) lúc server khởi động — sai thì log cảnh báo. Model mới nhớ thêm giá vào config/pricing.mjs.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# ── Gemini Image Gen (Auto Compare Video — Giai đoạn 1: sinh ảnh minh hoạ ngữ cảnh) ──
# Dùng chung GEMINI_API_KEY ở trên (trước đây tách riêng IMAGE_GEN_API_KEY để theo dõi chi phí
# sinh ảnh riêng, nhưng gộp lại cho gọn — cả 2 đều cùng 1 key/project trong thực tế).
# "Nano Banana" — model sinh ảnh của Gemini. gemini-2.5-flash-image bị Google NGỪNG HOẠT ĐỘNG
# từ 2026-10-02 — mặc định này CHỈ dùng tạm để test chất lượng ảnh ở giai đoạn hiện tại. Trước
# hoặc ngay khi mốc đó tới (tuỳ có quyết định dùng lâu dài hay không), đổi sang
# gemini-3.1-flash-image hoặc model kế nhiệm khác — request/response format đã verify giống hệt
# nhau (responseModalities, imageConfig.aspectRatio) giữa gemini-2.5-flash-image và
# gemini-3-pro-image-preview, nên CHỈ CẦN sửa giá trị dưới đây, KHÔNG cần sửa
# scripts/generate-context-image.mjs — trừ khi model kế nhiệm đổi hẳn shape này (báo lỗi 400 thì
# xem lại generationConfig ở đó). Kiểm tra tên model hiện hành tại
# https://ai.google.dev/gemini-api/docs/models trước khi đổi — test bằng
# `node scripts/generate-context-image.mjs "<concept>"`.
IMAGE_GEN_MODEL=gemini-2.5-flash-image

# ── Video series ─────────────────────────────────────────────
# Thị trường mặc định (mã locale = tên file trong config/locales/, vd vi-VN). Dữ liệu cũ thiếu `locale`,
# page Facebook thiếu FB_PAGE_n_LOCALE đều coi là thị trường này. Không đặt -> vi-VN.
DEFAULT_LOCALE=vi-VN

# Tên kênh hiển thị trên eyebrow tag (#eyebrow) trong mọi video
CHANNEL=Cường IT

# 0 = skill dừng lại xác nhận từng bước | 1 = chạy tự động không hỏi
AUTO_CREATE_VIDEO=0

# ── Facebook auto-post ───────────────────────────────────────
# Mỗi video render xong tự vào hàng đợi, đăng lên ĐÚNG 1 trong các page dưới đây (chọn ngẫu
# nhiên page nào đã "nghỉ" đủ FB_POST_MIN_GAP_MINUTES-FB_POST_MAX_GAP_MINUTES kể từ lần đăng gần
# nhất của CHÍNH page đó) — xem server.mjs (processSocialQueueTick) và scripts/lib/social-queue.mjs.
#
# Cách lấy FB_PAGE_n_ID / FB_PAGE_n_ACCESS_TOKEN (làm 1 lần, không cần OAuth trong app):
#   1. Vào https://developers.facebook.com/tools/explorer/, chọn Facebook App của bạn
#      (tạo App mới ở https://developers.facebook.com/apps nếu chưa có, loại "Business").
#   2. "User or Page" -> chọn User -> "Get Token" -> "Get User Access Token", tick quyền
#      pages_show_list, pages_manage_posts, pages_read_engagement -> Generate Access Token,
#      đăng nhập bằng tài khoản cá nhân đang quản trị 4 page.
#   3. Gọi GET /me/accounts (vẫn trong Graph API Explorer) -> trả về danh sách page bạn quản
#      trị, mỗi page kèm "id" và "access_token" riêng (đây chính là FB_PAGE_n_ID/ACCESS_TOKEN).
#   4. (Khuyến nghị) Đổi sang long-lived token để không hết hạn sau vài giờ: xem hướng dẫn
#      "Page Access Token chưa hết hạn" tại https://developers.facebook.com/docs/facebook-login/guides/access-tokens/get-long-lived
#      — hoặc đơn giản nhất, nếu 4 page đã nằm trong 1 Business Manager: Business Settings ->
#      System Users -> tạo 1 System User -> gán quyền cả 4 page -> generate token cho System
#      User (token loại này KHÔNG hết hạn).
# 1 = bật đăng tự động | 0 (hoặc false/off/no) = tắt hẳn (video vẫn render bình thường).
FB_AUTO_POST=1
# Phiên bản Graph API, khai báo DUY NHẤT ở đây (mặc định v19.0). Đổi khi Facebook ngừng hỗ trợ bản cũ.
FB_GRAPH_VERSION=v19.0
# "reel" (mặc định) = đăng dạng Reels — Facebook ưu tiên phân phối hơn cho video ngắn/dọc, nhưng
# bắt buộc đúng tỉ lệ 9:16 và dài 3-90s; video không đạt điều kiện TỰ ĐỘNG rơi về "video" (feed
# video thường) và ghi log lý do — xem reelEligibility() trong scripts/lib/mp4-probe.mjs và
# publishVideo() trong scripts/lib/facebook-post.mjs. Đặt "video" để LUÔN đăng feed video thường.
FB_POST_TYPE=reel
# Khoảng nghỉ NGẪU NHIÊN giữa 2 lần đăng lên CÙNG 1 page (phút).
FB_POST_MIN_GAP_MINUTES=30
FB_POST_MAX_GAP_MINUTES=60
# Khi Facebook báo rate limit (code 4/17/32/613...): hoãn job bao nhiêu phút (tối thiểu 15).
# Lỗi kiểu này KHÔNG tính vào số lần thử lại tối đa.
FB_RATE_LIMIT_BACKOFF_MINUTES=30
# Reel đã tạo nhưng Facebook chưa báo xong: theo dõi nền tối đa bao nhiêu phút rồi chốt "failed".
FB_VERIFY_TIMEOUT_MINUTES=30
# Số hashtag tối đa trong caption Reel (mặc định 4, kẹp 1-10). Bộ từ vựng: config/hashtags/<locale>.json;
# gợi ý cần người duyệt: data/hashtag-suggestions.json (KHÔNG bao giờ tự đăng).
FB_MAX_HASHTAGS=4
# Mỗi page cần đủ ID + ACCESS_TOKEN (Page Access Token, xem hướng dẫn phía trên); NAME chỉ để
# hiển thị log/UI. Hỗ trợ tới FB_PAGE_16_*. Slot thiếu ID hoặc token bị bỏ qua và báo khi khởi động.
# FB_PAGE_n_LOCALE = thị trường của page (mã file trong config/locales/, vd ja-JP). Không đặt -> DEFAULT_LOCALE. Video CHỈ được đăng lên page
# CÙNG thị trường: video thị trường nào không có page nào cùng locale thì không vào hàng đợi (log rõ lý do). Locale sai -> page bị bỏ qua.
FB_PAGE_1_ID=
FB_PAGE_1_NAME=
FB_PAGE_1_ACCESS_TOKEN=
FB_PAGE_1_LOCALE=
FB_PAGE_2_ID=
FB_PAGE_2_NAME=
FB_PAGE_2_ACCESS_TOKEN=
FB_PAGE_3_ID=
FB_PAGE_3_NAME=
FB_PAGE_3_ACCESS_TOKEN=
FB_PAGE_4_ID=
FB_PAGE_4_NAME=
FB_PAGE_4_ACCESS_TOKEN=
# Ảnh bìa Reel: frame ngẫu nhiên trong [FB_THUMB_START_SEC, duration - FB_THUMB_END_OFFSET_SEC].
# Lấy trong đoạn từ giây FB_THUMB_START_SEC tới (độ dài video - FB_THUMB_END_OFFSET_SEC).
FB_THUMB_START_SEC=3
FB_THUMB_END_OFFSET_SEC=2
# ffmpeg mặc định dùng gói npm ffmpeg-static (không phụ thuộc máy). Chỉ đặt FFMPEG_PATH nếu muốn
# dùng binary khác; KHÔNG dùng ffmpeg trong PATH hệ thống.
# FFMPEG_PATH=C:\tools\ffmpeg\bin\ffmpeg.exe

# Tỷ giá USD→VND dùng để hiện số tiền ước tính (≈ …₫) ở "Thống kê chi phí". Là số cố định bạn tự đặt, KHÔNG phải tỷ giá
# thời gian thực. Bỏ trống hoặc giá trị không hợp lệ = 26000. Đổi xong khởi động lại server.
USD_TO_VND=26000
