# Dependencies
node_modules/

# Environment files — one shared .env at repo root (Vbee/Gemini credentials); no
# leading slash, so this also catches an accidental .env dropped inside videos/<name>/
.env
.env.local
.env.*.local

# HyperFrames / editor caches — per video (videos/<name>/.hyperframes/ etc.),
# matched at any depth since these patterns have no leading slash
.hyperframes/
.thumbnails/
.waveform-cache/

# Render outputs and snapshots — per video, regenerated by `npm run render` /
# `hyperframes snapshot`, not committed (MP4s are ~8MB each)
renders/
snapshots/

# Web UI working directories — uploads are copies of what the user dragged in,
# temp holds the Gemini content hand-off between /api/generate-content and
# /api/create-video. Both are scratch.
assets/uploads/
assets/temp/

# Image files & Stock media
Ảnh stock/
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.svg
!docs/previews/*

# --- Re-includes (must come after the blanket image rules above) ---

# Shared host pose library. Despite the .svg extension these are raster photos
# of the host wrapped in an SVG <mask> — irreplaceable source art that cannot be
# regenerated, plus actions.json which carries the measured head geometry every
# composition depends on.
!assets/actions/**
!assets/backgrounds/**

# Per-video sources ARE committed as of 2026-08-30.
#
# The previous rule here was `videos/*` plus an allowlist of two directories,
# so every other video project stayed untracked — and when 7 of them were
# deleted off disk on 2026-08-30 there was nothing to restore from. The heavy,
# regenerable outputs (renders/, snapshots/, node_modules/) are still excluded
# by the rules above, which leaves ~370KB of real source per video: index.html,
# the VO mp3s, the two comparison images, and the scripts.
#
# The per-video assets/actions/ copies are byte-identical to the shared library,
# and git stores blobs by content hash, so committing them costs essentially
# nothing and keeps each restored video runnable without a re-copy step.
!videos/*/assets/**

# VieNeu-TTS — vendored source (upstream github.com/pnnbao97/VieNeu-TTS @ v3.6.4,
# Apache-2.0; LICENSE kept in place). The ~6MB of source IS committed so a plain
# `git pull` leaves the TTS provider runnable after one `npm run setup:vieneu`.
# What is NOT committed, and why:
#   .venv/               ~980MB, machine-specific (abs paths + editable install);
#                        recreated by scripts/setup-vieneu.mjs
#   .git-upstream-clone/ ~32MB, the upstream clone's own .git, renamed out of the
#                        way so git treats this as a normal subtree instead of a
#                        nested repo. Restore with `mv .git-upstream-clone .git`
#                        if you ever need to diff/pull against upstream again.
# Model weights are NOT here at all — huggingface_hub downloads ~580MB into
# ~/.cache/huggingface on first run. VieNeu-TTS/.gitignore handles __pycache__,
# *.egg-info and outputs/ for this subtree.
VieNeu-TTS/.venv/
VieNeu-TTS/.git-upstream-clone/

# Claude Code — project skills (.claude/skills/) ARE committed; only the
# machine-local settings override is not
.claude/settings.local.json

# Editor
.vscode/

